<%- include('partials/head') %>
<section class="hero">
  <div class="wrap">
    <h1>Popüler ürünler, <span class="accent">uygun fiyat</span></h1>
    <p>Seçilmiş ürünler kapıda ödeme ve hızlı kargo ile kapınızda.</p>
  </div>
</section>
<section class="wrap section">
  <%- include('partials/badges') %>
  <h2 class="section-title">Ürünler</h2>
  <% if (!products.length) { %>
    <p class="muted">Şu an satışta ürün bulunmuyor. Yakında yeni ürünlerle buradayız.</p>
  <% } %>
  <div class="grid">
    <% products.forEach(function (p) { %><%- include('partials/card', { p }) %><% }) %>
  </div>
</section>
<%- include('partials/foot') %>
