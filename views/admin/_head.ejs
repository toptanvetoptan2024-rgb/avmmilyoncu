<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · Yönetim</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin">
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/yonetim" class="logo"><span class="logo-mark">AVM</span><span class="logo-text">Yönetim</span></a>
    <% if (typeof hideNav === 'undefined') { %>
    <form method="post" action="/yonetim/cikis"><button class="link-btn">Çıkış</button></form>
    <% } %>
  </div>
  <% if (typeof hideNav === 'undefined') { %>
  <nav class="admin-nav wrap">
    <a href="/yonetim" class="<%= path === '/' ? 'on' : '' %>">Panel</a>
    <a href="/yonetim/urunler" class="<%= path.startsWith('/urunler') ? 'on' : '' %>">Ürünler</a>
    <a href="/yonetim/siparisler" class="<%= path.startsWith('/siparisler') ? 'on' : '' %>">Siparişler</a>
    <a href="/yonetim/reklam" class="<%= path.startsWith('/reklam') ? 'on' : '' %>">Reklam</a>
    <a href="/" target="_blank">Siteyi gör ↗</a>
  </nav>
  <% } %>
</header>
<% if (testMode) { %><div class="test-bar">TEST MODU – kart ödemeleri simülasyon. Canlı ödeme için PAYMENT_MODE=live ve gerçek sağlayıcı gerekir.</div><% } %>
<main class="wrap section">
