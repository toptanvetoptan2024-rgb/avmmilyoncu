<%- include('_head') %>
<div class="page-head">
  <h1>Sipariş <%= order.order_no %></h1>
  <span class="tag tag-<%= order.status %>"><%= config.orderStatusLabels[order.status] %></span>
</div>
<% if (order.is_test) { %><div class="alert">Bu bir TEST siparişi. Raporlara dahil edilmez.</div><% } %>
<div class="cols">
  <dl class="summary">
    <dt>Tarih</dt><dd><%= formatDateTime(order.created_at) %></dd>
    <dt>Müşteri</dt><dd><%= order.customer_name %></dd>
    <dt>Telefon</dt><dd><a href="tel:<%= order.phone %>"><%= order.phone %></a></dd>
    <dt>Adres</dt><dd><%= order.address %><br><%= order.district %> / <%= order.city %></dd>
    <% if (order.note) { %><dt>Not</dt><dd><%= order.note %></dd><% } %>
    <dt>Ürün</dt><dd><%= order.product_name %> × <%= order.quantity %></dd>
    <dt>Tutar</dt><dd><%= formatTRY(order.total) %></dd>
    <dt>Maliyet</dt><dd><%= formatTRY(order.unit_cost * order.quantity) %> ürün + <%= formatTRY(order.shipping_cost) %> kargo</dd>
    <dt>Brüt kâr</dt><dd><%= formatTRY(order.total - order.unit_cost * order.quantity - order.shipping_cost) %></dd>
    <dt>Ödeme</dt><dd><%= config.paymentMethods[order.payment_method] %> – <%= { bekliyor: 'bekliyor', odendi: 'ödendi', basarisiz: 'başarısız' }[order.payment_status] %></dd>
    <dt>Kaynak</dt><dd><%= [order.utm_source, order.utm_medium, order.utm_campaign, order.utm_content].filter(Boolean).join(' / ') || '–' %></dd>
  </dl>
  <form method="post" class="form">
    <label>Sipariş durumu
      <select name="status"><% config.orderStatuses.forEach(function (s) { %><option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= config.orderStatusLabels[s] %></option><% }) %></select>
    </label>
    <label>Ödeme durumu
      <select name="payment_status">
        <% [['bekliyor','Bekliyor'],['odendi','Ödendi'],['basarisiz','Başarısız']].forEach(function (s) { %><option value="<%= s[0] %>" <%= order.payment_status === s[0] ? 'selected' : '' %>><%= s[1] %></option><% }) %>
      </select>
    </label>
    <label>Test siparişi mi?
      <select name="is_test"><option value="0" <%= !order.is_test ? 'selected' : '' %>>Hayır (gerçek)</option><option value="1" <%= order.is_test ? 'selected' : '' %>>Evet (raporlara girmesin)</option></select>
    </label>
    <label>Not ekle <input name="note" placeholder="Örn: Müşteri arandı, teyit edildi"></label>
    <button class="btn btn-block">Kaydet</button>
    <p class="muted small">Siparişler silinmez. Gerekirse "İptal" durumuna alın.</p>
  </form>
</div>
<h2>Geçmiş</h2>
<ul class="timeline">
  <% events.forEach(function (e) { %><li><span class="muted small"><%= formatDateTime(e.created_at) %></span> <%= e.event %></li><% }) %>
</ul>
<p><a href="/yonetim/siparisler">← Siparişlere dön</a></p>
<%- include('_foot') %>
